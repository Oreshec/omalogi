# Omalogi: give the user logged in at the seat access to supported Logitech mice.
#
# Only the HID++ interface of devices Omalogi has been tested on is matched; the mouse's
# pointer interface and every other device keep their defaults. `uaccess` lets
# systemd-logind grant access to the active session's user, so no group or root is needed.
#
# ATTRS keys must all match one parent device, so the USB interface is matched through
# ID_USB_INTERFACE_NUM, a property of the hidraw node set by 60-persistent-hidraw.rules.
#
# Install:  sudo install -Dm644 70-omalogi.rules /usr/lib/udev/rules.d/70-omalogi.rules
#           sudo udevadm control --reload-rules && sudo udevadm trigger --subsystem-match=hidraw
# Remove:   sudo rm /usr/lib/udev/rules.d/70-omalogi.rules && sudo udevadm control --reload-rules

# Logitech G502 X, wired (046d:c099): HID++ on USB interface 1. Verified.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c099", ENV{ID_USB_INTERFACE_NUM}=="01", TAG+="uaccess"

# Logitech Unifying, Nano, LIGHTSPEED and Bolt receivers, for wireless mice behind them
# (receiver ids from OpenLogi's device registry).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c52b|c532|c537|c539|c53f|c547|c548|c54d", TAG+="uaccess"

# Untested wired G-series mice with onboard profiles (USB ids from libratbag). Their
# HID++ interface number is not verified, so every hidraw node of these mice is matched,
# as Solaar's and libratbag's rules do; Omalogi itself only opens the HID++ interface.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c07d|c07e|c07f|c080|c081|c082|c083|c084|c085|c086|c087|c088|c08b|c08c|c08d|c08e|c08f|c090|c091|c092|c094|c095|c096|c097|c098|c09d|c332", TAG+="uaccess"
